# Copiar este arquivo para .env e preencher os valores antes de iniciar em producao.
# Uso: set SECRET_KEY=... (Windows) ou export SECRET_KEY=... (Linux)

# ── Obrigatorio em producao ──────────────────────────────────────
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# ── Primeiro acesso (somente banco novo/sem usuarios) ─────────────
# Defina uma senha forte antes da primeira inicializacao. Depois que o primeiro
# administrador for criado, esta variavel pode ser removida do ambiente/.env.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrador

# ── Servidor ─────────────────────────────────────────────────────
PORT=5000
WAITRESS_THREADS=16

# ── Email legado SMTP (opcional) ────────────────────────────────
# Mantido por compatibilidade. Para o fluxo de Residentes/Doutorandos,
# prefira a integração Outlook/Microsoft Graph abaixo.
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Microsoft Forms (entrada via Power Automate/webhook) ─────────
FORMS_WEBHOOK_ENABLED=false
# Gere uma chave longa e aleatoria; configure a mesma no header
# X-Forms-Webhook-Secret da acao HTTP do Power Automate.
FORMS_WEBHOOK_SECRET=

# ── Outlook / Microsoft Graph (envio com confirmacao humana) ─────
OUTLOOK_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Caixa de correio/remetente usado no endpoint /users/{sender}/sendMail.
OUTLOOK_SENDER=
# Normalmente nao altere:
MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
MICROSOFT_GRAPH_BASE=https://graph.microsoft.com/v1.0

# ── Assistente IA / OpenRouter (opcional) ─────────────────────────
# Gere uma chave em https://openrouter.ai/keys
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Armazenamento privado de documentos. Inclua esta pasta nos backups.
ERP_FILES_DIR=
